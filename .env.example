# ─────────────────────────────────────────────────────────────────────────────
# WA Outreach Engine — Environment Variables
#
# This file is for Docker Compose and for Railway/Vercel platform variables,
# where the whole stack reads one shared env (or each platform injects its
# own). Copy it to .env and fill in all REQUIRED values before starting.
#
# Running locally WITHOUT Docker (`pnpm dev` / `pnpm --filter ... dev`)?
# NestJS's ConfigModule resolves its env file relative to process.cwd(), so
# the API actually reads apps/api/.env (not this root file), and Next.js
# reads apps/web/.env.local. Use apps/api/.env.example and
# apps/web/.env.example instead — copying only this root file will leave
# the API crashing at boot with a missing-config error.
#
# Never commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────

# REQUIRED  Node environment (production | development | test)
NODE_ENV=production

# OPTIONAL  Shared secret for the API key guard (X-API-Key header).
#           When set, ALL non-public API endpoints require this header.
#           Public endpoints (webhooks, /health) are always exempt.
#           Generate with: openssl rand -hex 32
#           Leave empty to disable the guard (not recommended in production).
API_KEY=

# REQUIRED  Set to true until you have verified real sends work correctly.
#           When true, messages are logged instead of sent (safe for testing).
DRY_RUN=true

# REQUIRED  Domain name for production SSL and CORS.
DOMAIN=yourdomain.com

# ── Database — Supabase ───────────────────────────────────────────────────────

# REQUIRED  Pooler URL (port 6543) — used by Prisma Client at runtime.
#           Get from Supabase → Settings → Database → Connection string (Transaction mode).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# REQUIRED  Direct URL (port 5432) — used by Prisma Migrate only.
#           Get from Supabase → Settings → Database → Connection string (Direct).
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Cache / Queue ─────────────────────────────────────────────────────────────

# REQUIRED (docker-compose)  Redis password. docker-compose sets REDIS_URL automatically using this.
#           For external Redis (e.g. Redis Cloud), ignore this and set REDIS_URL directly below.
#           Generate with: openssl rand -hex 16
REDIS_PASSWORD=

# REQUIRED  Redis connection URL.
#           docker-compose overrides this automatically from REDIS_PASSWORD.
#           For external Redis, set this directly: redis://:password@host:port/db
REDIS_URL=redis://redis:6379

# ── Meta Cloud API — Mode 1 (official WhatsApp Business API) ─────────────────

# REQUIRED for Cloud API.  Used to validate X-Hub-Signature-256 on incoming webhooks.
#           Find in Meta Developer Console → App → Settings → Basic → App Secret.
#           Without this, the webhook endpoint accepts unsigned payloads (security risk).
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# OPTIONAL  BCP-47 language code used for all Cloud API template sends (default: en_US).
#           Override if your Meta-approved templates are in a different language, e.g. ur (Urdu),
#           ar (Arabic), es_AR (Spanish Argentina). Find the exact code in Meta Business Manager.
META_DEFAULT_TEMPLATE_LANGUAGE=en_US

# ── AI — NEXUS Campaign Brain ─────────────────────────────────────────────────

# REQUIRED  AI provider to use for message generation and reply analysis.
#           Values: anthropic (default) | openai
AI_PROVIDER=anthropic

# REQUIRED when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# REQUIRED when AI_PROVIDER=openai
OPENAI_API_KEY=

# ── Anti-ban ─────────────────────────────────────────────────────────────────

# REQUIRED  32-byte key for encrypting Baileys session auth state in the DB.
#           Generate with: openssl rand -hex 32
#           WARNING: changing this invalidates all stored sessions.
SESSION_ENCRYPTION_KEY=

# REQUIRED  Secret used to sign panel login JWTs.
#           Generate with: openssl rand -hex 32
#           WARNING: changing this logs everyone out immediately.
JWT_SECRET=

# ── Queue / Delay engine ─────────────────────────────────────────────────────

# OPTIONAL  Gaussian mean inter-message delay in milliseconds (default: 120000 = 2min).
#           Safe WhatsApp range: 60,000–480,000. Do NOT go below 60,000 on new numbers.
#           UAE recommendation: 120,000 (2 min mean — balanced throughput vs ban safety).
DELAY_MEAN_MS=120000

# OPTIONAL  Gaussian standard deviation for delay in milliseconds (default: 35000).
#           Larger values produce more natural-looking human variance.
DELAY_STD_DEV_MS=35000

# OPTIONAL  Hard minimum delay floor in milliseconds (default: 60000 = 1min).
#           Worker enforces this via Redis regardless of BullMQ queue timing.
DELAY_FLOOR_MS=60000

# OPTIONAL  Hard maximum delay ceiling in milliseconds (default: 480000 = 8min).
#           Upper cap prevents outlier Gaussian draws from stalling campaigns.
DELAY_CEILING_MS=480000

# OPTIONAL  Typing-indicator BASE before each Baileys send (ms, default: 3000). The actual
#           typing time scales with message length + jitter and is clamped to 1000–15000ms.
TYPING_SIMULATION_MS=3000

# OPTIONAL  Post-warmup daily send cap per session (default: 1000). Applies from warmup day 40+.
#           The warmup schedule (fixed in code) ramps up to this value over ~40 days.
DAILY_SEND_LIMIT=1000

# OPTIONAL  Fraction of the daily cap allowed within any single clock hour (default: 0.2).
#           Spreads volume across the day instead of dumping it in a few hours. Range (0,1].
HOURLY_CAP_FRACTION=0.2

# OPTIONAL  Human "burst break": after a random N sends in [min,max], the session pauses
#           15–45 min before continuing (defaults 8 and 12). Breaks up metronomic timing.
BURST_BREAK_MIN_SENDS=8
BURST_BREAK_MAX_SENDS=12

# OPTIONAL  IANA timezone for the active-hours gate.
#           Set to your target market timezone so messages only send during local business hours.
#           Examples: Asia/Dubai | Asia/Karachi | Africa/Lagos | America/New_York | Europe/London
ACTIVE_HOURS_TIMEZONE=Asia/Dubai

# OPTIONAL  How many hours before a proxy assignment is rotated (default: 24).
PROXY_ROTATION_HOURS=24

# ── Frontend ─────────────────────────────────────────────────────────────────

# REQUIRED  Internal URL the NestJS API is reachable at inside Docker (used by Next.js server-side calls).
#           Docker Compose: http://api:3001
#           Railway + Vercel: https://your-api.up.railway.app/api
#           (On Vercel, set this as a non-public env var — it's server-side only)
API_URL=http://api:3001

# REQUIRED  URL of the NestJS API as seen from the BROWSER (baked into JS bundle at build time).
#           Used for Socket.io WebSocket connection from the client.
#           Docker Compose: https://yourdomain.com
#           Railway + Vercel: https://your-api.up.railway.app  (no /api suffix)
#           WARNING: on Vercel this must be set BEFORE the build — it cannot be changed post-deploy.
NEXT_PUBLIC_API_URL=https://yourdomain.com

# REQUIRED  Allowed CORS origin for the Socket.io server on the API.
#           Must match the exact origin the browser connects from (no trailing slash).
#           Docker Compose: https://yourdomain.com
#           Railway + Vercel: https://your-app.vercel.app  (or your custom Vercel domain)
FRONTEND_URL=https://yourdomain.com

# ── Server ────────────────────────────────────────────────────────────────────

# OPTIONAL  Port the NestJS API listens on (default: 3001).
#           Railway sets PORT automatically — do not override on Railway.
PORT=3001

# OPTIONAL  Filesystem path for uploaded media files (default: uploads/ next to process cwd).
#           Docker Compose: handled by named volume — no action needed.
#           Railway: create a Volume in the Railway project dashboard and set its
#           mount path to /app/apps/api/uploads — then set UPLOAD_DIR to that path.
#           Without a Railway Volume, uploaded files are lost on every redeploy.
UPLOAD_DIR=uploads

# ── AI model override ─────────────────────────────────────────────────────────

# OPTIONAL  AI model ID to use (default: claude-haiku-4-5 for Anthropic, gpt-4o for OpenAI).
#           For Anthropic: claude-haiku-4-5 | claude-sonnet-4-6 | claude-opus-4-8
#           For OpenAI: gpt-4o | gpt-4o-mini | gpt-4-turbo
AI_MODEL=

# ── Railway + Vercel deployment checklist ─────────────────────────────────────
#
# RAILWAY (API service):
#   1. New project → Add service → GitHub repo → select Dockerfile: apps/api/Dockerfile
#      (railway.toml at repo root already configures this)
#   2. Add a Redis service to the same Railway project; copy its REDIS_URL into
#      the API service env vars (Railway injects ${{Redis.REDIS_URL}} via variable references)
#   3. Set all REQUIRED env vars above in Railway's Variables tab:
#        DATABASE_URL, DIRECT_URL (Supabase)
#        SESSION_ENCRYPTION_KEY (openssl rand -hex 32)
#        ANTHROPIC_API_KEY or OPENAI_API_KEY
#        FRONTEND_URL = your Vercel URL
#        DRY_RUN = false  (flip to false once you've verified sends work)
#   4. Media uploads: Railway dashboard → your API service → Volumes → Add Volume
#        Mount path: /app/apps/api/uploads
#        Then set UPLOAD_DIR=/app/apps/api/uploads in env vars.
#      Skip this step if the client won't use media attachments.
#   5. Database migrations run automatically on every deploy via start.sh.
#      No manual migration step needed.
#
# VERCEL (web panel):
#   1. New project → Import GitHub repo
#   2. Framework Preset: Next.js (auto-detected)
#   3. Root Directory: leave blank (use repo root) — vercel.json handles the rest
#   4. Set env vars in Vercel's Environment Variables section:
#        API_URL = https://your-api.up.railway.app/api   (server-side, not public)
#        NEXT_PUBLIC_API_URL = https://your-api.up.railway.app   (baked into bundle)
#        API_KEY = <same value as on Railway, if you set one>
#   5. Deploy. NEXT_PUBLIC_API_URL is baked at build time — update it in Vercel
#      and redeploy if the Railway URL ever changes.
#
# ─────────────────────────────────────────────────────────────────────────────
